{
  "name": "rondas-arc-simon-bolivar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "static": "vite build && npx cap sync",
    "electron": "electron electron/main.js",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@google/genai": "^1.34.0",
    "@types/jszip": "^3.4.0",
    "body-parser": "^2.2.2",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.arc.simonbolivar",
    "productName": "Rondas ARC Simon Bolivar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": ["**/*"]
      },
      {
        "from": "server/database",
        "to": "server/database",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "ARCico.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true
    }
  }
}
